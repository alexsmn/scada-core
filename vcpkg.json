{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "scada-core",
  "version-string": "2.6.0",
  "description": "Telecontrol SCADA - Core libraries",
  "$consumes": [
    "third_party/net"
  ],
  "$direct": [
    "boost-algorithm",
    "boost-asio",
    "boost-beast",
    "boost-container-hash",
    "boost-date-time",
    "boost-filesystem",
    "boost-json",
    "boost-locale",
    "boost-log",
    "boost-mpl",
    "boost-program-options",
    "boost-range",
    "boost-signals2",
    "boost-smart-ptr",
    "boost-uuid",
    "gtest",
    {
      "name": "opentelemetry-cpp",
      "features": [
        "otlp-grpc"
      ]
    },
    "protobuf"
  ],
  "$generated": "`dependencies` is generated by tools/deps/gen_manifests.py from `$direct` and `$consumes`. Do not edit it by hand; edit `$direct` and re-run. See docs/adr/0010-generated-product-manifests.md.",
  "dependencies": [
    "boost-algorithm",
    "boost-asio",
    "boost-assert",
    "boost-beast",
    "boost-container-hash",
    "boost-date-time",
    "boost-filesystem",
    "boost-json",
    "boost-locale",
    "boost-log",
    "boost-mpl",
    "boost-program-options",
    "boost-random",
    "boost-range",
    "boost-signals2",
    "boost-smart-ptr",
    "boost-system",
    "boost-uuid",
    "gtest",
    "openssl",
    {
      "name": "opentelemetry-cpp",
      "features": [
        "otlp-grpc"
      ]
    },
    "protobuf"
  ],
  "features": {
    "benchmarks": {
      "description": "Build the opt-in Google Benchmark executables.",
      "$direct": [
        "benchmark"
      ],
      "dependencies": [
        "benchmark"
      ]
    }
  }
}
