@startuml remote_disconnect
!include _style.puml

title Core remote — disconnect

participant "SessionProxy" as Client $external
participant "ServerConnection" as Conn $tier
participant "RemoteSessionManager" as Manager $tier
participant "SessionStub" as Session $tier
participant "Underlying service" as Service $tier

Client -> Conn : DeleteSession / transport close
Conn -> Session : SetConnection(nullptr)
Conn -> Manager : delete_session_handler(session)
Manager -> Manager : Remove from session map
Client --> Client : Complete pending requests with Bad_Disconnected
Service --> Session : Late completion
Session --> Session : Ignore, no live connection

@enduml
